# Copy this file to .env (gitignored) and fill in the values for the target
# cluster, then run ./deploy.sh.  Every value below maps directly to a key in
# one of the three Secret objects deploy.sh creates.

# === target namespace + project ===
NAMESPACE=gbaia

# === Cluster wiring — only change when redeploying to a different cluster ===
# vLLM-compatible OpenAI endpoint (Mistral, Qwen, Llama, etc.). Leave empty to
# fall back to OpenAI hosted models (then set OPENAI_API_KEY below).
LOCAL_LLM_URL=http://qwen36-27b.runai-shared-models.svc:8000/v1
LOCAL_LLM_MODEL=qwen3.6-27b
LOCAL_LLM_TOKEN=                       # bearer token for the LLM endpoint, if any

# External URL the browser hits to reach the backend's /api/capabilities.
# Must be the FQDN of the gbaia-backend route. Leave blank to skip wiring
# (frontend will fall back and the browser-side capabilities probe will fail).
BACKEND_EXTERNAL_URL=

# === gbaia-secrets ===
APIC_URL=https://apic.example.com
APIC_USER=
APIC_PASSWORD=
ND_URL=https://nd.example.com
ND_USER=
ND_PASSWORD=                           # 64-char hex = ND API key (auto-detected)
NEO4J_PASSWORD=                        # initial password for the bundled neo4j
OPENAI_API_KEY=                        # optional, only if LOCAL_LLM_URL is empty
AI_DEFENSE_API_KEY=                    # optional
MODEL_PROXY_API_KEY=                   # optional
SPLUNK_ACCESS_TOKEN=                   # optional

# === gbaia-nd-mcp-secrets ===
# DATABASE_URL is auto-derived from POSTGRES_* below
POSTGRES_DB=ndmcp
POSTGRES_USER=ndmcp
POSTGRES_PASSWORD=                     # any strong secret
POSTGRES_HOST=gbaia-nd-mcp-postgres
POSTGRES_PORT=5432
MCP_API_TOKEN=                         # any strong secret; backend uses this to auth to MCP
ENCRYPTION_KEY=                        # leave blank; deploy.sh generates a Fernet key

# === gbaia-intersight-secrets ===
# REGION = intersight.com (US) or eu-central-1.intersight.com (EU) etc.
INTERSIGHT_REGION_HOST=eu-central-1.intersight.com
INTERSIGHT_API_KEY_ID=                 # format: <account-moid>/<user-moid>/<key-moid>
INTERSIGHT_PRIVATE_KEY_FILE=./intersight-private-key.pem   # path to PEM on disk

# === optional source-repo overrides (only set if you forked the repos) ===
BACKEND_GIT_URI=https://github.com/kubeages/cisco-network-ai-agent
ND_MCP_GIT_URI=https://github.com/kubeages/nexus-dashboard-mcp.git
INTERSIGHT_MCP_GIT_URI=https://github.com/jim-coyne/Intersight_MCP.git
